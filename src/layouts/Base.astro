---
import Seo from "../components/Seo.astro";
import Lockup from "../components/Lockup.astro";
import Wordmark from "../components/Wordmark.astro";
import { site } from "../site.js";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pageType?: string;
  noindex?: boolean;
  graph?: object[];
}

const seo = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const nav = [
  ["/#work", "work"],
  ["/blog/", "blog"],
  ["/about/", "about"],
  ["/brand/", "brand"],
];
---
<!doctype html>
<html lang={site.locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f120f" media="(prefers-color-scheme: dark)">
  <meta name="color-scheme" content="light dark">
  <Seo {...seo} />
  {site.umamiWebsiteId && (
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={site.umamiWebsiteId} data-domains="littleunknown.com"></script>
  )}
</head>
<body>
  <!-- data-nosnippet keeps site chrome out of search snippets; Google honours it on div, not header/footer. -->
  <div data-nosnippet>
  <a class="skip" href="#content">skip to content</a>
  <header class="site-header wrap">
    <a class="home" href="/" aria-label="little unknown, home"><Lockup /></a>
    <nav aria-label="Main">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={path === href || (href === "/blog/" && path.startsWith("/blog/")) ? "page" : undefined}>{label}</a>
      ))}
    </nav>
  </header>
  </div>

  <main id="content" class="wrap">
    <slot />
  </main>

  <div data-nosnippet>
  <footer class="site-footer wrap">
    <a class="footer-mark" href="/" aria-label="little unknown, home"><Wordmark /></a>
    <div class="footer-base">
      <nav aria-label="Footer">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <span class="comment">© {year} {site.name}</span>
    </div>
  </footer>
  </div>
</body>
</html>
