---
import Seo from "../components/Seo.astro";
import Lockup from "../components/Lockup.astro";
import Wordmark from "../components/Wordmark.astro";
import { site } from "../site.js";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  pageType?: string;
  noindex?: boolean;
  graph?: object[];
  wide?: boolean;
}

const { wide = false, ...seo } = Astro.props;
const path = Astro.url.pathname;
const year = new Date().getFullYear();
const nav = [
  ["/#work", "work"],
  ["/about/", "about"],
  ["/brand/", "brand"],
];
---
<!doctype html>
<html lang={site.locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#eef0ec" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f120f" media="(prefers-color-scheme: dark)">
  <meta name="color-scheme" content="light dark">
  <Seo {...seo} />
</head>
<body>
  <a class="skip" href="#content">skip to content</a>
  <header class="site-header wrap wide">
    <a class="home" href="/" aria-label="little unknown, home"><Lockup /></a>
    <nav aria-label="Main">
      {nav.map(([href, label]) => (
        <a href={href} aria-current={path === href ? "page" : undefined}>{label}</a>
      ))}
    </nav>
  </header>

  <main id="content" class:list={["wrap", { wide }]}>
    <slot />
  </main>

  <footer class="site-footer wrap wide">
    <div class="footer-cols">
      <p class="footer-note">// {site.tagline}</p>
      <div>
        <p class="comment">// studio</p>
        <ul>{nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </div>
      <div>
        <p class="comment">// elsewhere</p>
        <ul>
          <li><a href={site.founder.url} rel="author">naman vashistha</a></li>
          <li><a href="https://github.com/namanvashistha">github</a></li>
        </ul>
      </div>
    </div>
    <a class="footer-mark" href="/" aria-label="little unknown, home"><Wordmark /></a>
    <div class="footer-base comment">
      <span>© {year} {site.name}</span>
      <a href="#content">back to top ↑</a>
    </div>
  </footer>
</body>
</html>
