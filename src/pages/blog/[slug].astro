---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { site } from "../../site.js";
import { posts, formatDate, isoDate, readingMinutes } from "../../lib/blog";

export async function getStaticPaths() {
  const list = await posts();
  return list.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: list[i - 1], older: list[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, createdAt, updatedAt } = post.data;
const url = `${site.url}/blog/${post.id}/`;

const postGraph = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    headline: title,
    description,
    datePublished: isoDate(createdAt),
    dateModified: isoDate(updatedAt ?? createdAt),
    url,
    mainEntityOfPage: url,
    image: `${site.url}/og.png`,
    inLanguage: site.locale,
    author: { "@id": `${site.url}/#organization` },
    publisher: { "@id": `${site.url}/#organization` },
    isPartOf: { "@id": `${site.url}/blog/#blog` },
  },
];
---
<Base title={`${title} · ${site.name}`} description={description} graph={postGraph}>
  <article class="post">
    <header class="post-head">
      <a class="back comment" href="/blog/">← blog</a>
      <h1>{title}</h1>
      <p class="meta comment">
        <time datetime={isoDate(createdAt)}>{formatDate(createdAt)}</time> · {readingMinutes(post.body)} min read
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <p class="byline">Written by {site.name}.</p>
      {(newer || older) && (
        <nav class="pager" aria-label="More posts">
          {older ? <a href={`/blog/${older.id}/`}><span class="comment">older</span>{older.data.title}</a> : <span />}
          {newer && <a class="next" href={`/blog/${newer.id}/`}><span class="comment">newer</span>{newer.data.title}</a>}
        </nav>
      )}
    </footer>
  </article>
</Base>

<style>
  .back { font-size: 14px; }
  .back:hover { color: var(--ink); text-decoration: none; }
  h1 { margin-top: 28px; max-width: 18ch; font-size: clamp(2.2rem, 6vw, 3.8rem); font-weight: 700; letter-spacing: -0.045em; line-height: 1.05; text-wrap: balance; }
  .meta { margin-top: 20px; font-size: 14px; white-space: nowrap; }

  /* Long-form text: sans at a comfortable measure, mono for headings. */
  .prose { margin-top: 64px; max-width: 64ch; font-size: 18px; line-height: 1.7; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { margin-top: 2.2em; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.3; }
  .prose :global(h2 + *) { margin-top: .6em; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; }
  .prose :global(li + li) { margin-top: .35em; }
  .prose :global(strong) { font-weight: 500; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }
  .prose :global(blockquote) { padding-left: 1em; border-left: 2px solid var(--signal); color: var(--graphite); }
  .prose :global(code) { font-size: .9em; }

  .post-foot { margin-top: var(--gap-section); max-width: 64ch; }
  .byline { color: var(--graphite); }
  .pager { margin-top: 32px; display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--rule); padding-top: 24px; }
  .pager a { display: flex; flex-direction: column; gap: 4px; color: var(--ink); font-family: var(--mono); font-weight: 700; max-width: 45%; }
  .pager a:hover { color: var(--signal); text-decoration: none; }
  .pager .comment { font-weight: 400; font-size: 13px; }
  .pager .next { text-align: right; margin-left: auto; }
</style>
