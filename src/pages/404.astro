---
import Base from "../layouts/Base.astro";
import { site } from "../site.js";
---
<Base title={`not found · ${site.name}`} description="This page doesn't exist." noindex>
  <h1>404<span class="cursor" aria-hidden="true">_</span></h1>
  <p class="comment">// this one is still unknown.</p>
  <p class="back"><a href="/">← back to littleunknown.com</a></p>
</Base>

<style>
  :global(main) { display: flex; flex-direction: column; justify-content: center; }
  h1 { font-weight: 500; font-size: clamp(2.5rem, 9vw, 4.4rem); letter-spacing: -0.04em; line-height: 1; }
  p { margin-top: 18px; }
  .back { margin-top: 40px; }
</style>
