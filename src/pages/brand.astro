---
import Base from "../layouts/Base.astro";
import SectionMark from "../components/SectionMark.astro";
import PageHead from "../components/PageHead.astro";
import LogoSting from "../components/LogoSting.astro";
import DotWave from "../components/DotWave.astro";
import BrandMotion from "../components/BrandMotion.astro";
import Lockup from "../components/Lockup.astro";
import Mark from "../components/Mark.astro";
import Wordmark from "../components/Wordmark.astro";
import { site } from "../site.js";
import { colors as c } from "../lib/mark.js";
import { social } from "../lib/social.js";

const swatches = [
  ["paper", c.paper, "backgrounds"],
  ["ink", c.ink, "text, the known dots"],
  ["vermilion", c.vermilion, "the lit dots, \"little\", one accent"],
  ["vermilion deep", c.vermilionDeep, "links and small text on light"],
  ["night", c.night, "dark backgrounds, app icon"],
  ["moon", c.moon, "text and dots on dark"],
  ["graphite", c.graphite, "secondary text, // comments"],
];

const files = [
  ["lockup-light", "Logo, for light backgrounds"],
  ["lockup-dark", "Logo, for dark backgrounds"],
  ["lockup-on-vermilion", "Logo, one colour, on vermilion"],
  ["mark-light", "Mark, for light backgrounds"],
  ["mark-dark", "Mark, for dark backgrounds"],
  ["wordmark-light", "Wordmark, for light backgrounds"],
  ["wordmark-dark", "Wordmark, for dark backgrounds"],
];
const f = (name, ext) => `/brand/little-unknown-${name}.${ext}`;

const donts = [
  "Don't recolour the dots, or light more or fewer than three.",
  "Don't rearrange the dots or move the lit ones.",
  "Don't move \"little\" out of the space above \"un\". Set it in vermilion, or in night when the background is vermilion.",
  "Don't set the wordmark in another font, stretch it, or add shadows, outlines or gradients.",
  "Only place the logo on paper, white, night or vermilion, and never on a busy photo.",
];
---
<Base
  title={`brand · ${site.name}`}
  description="The little unknown logo, colours, type and voice, with logo files to download."
>
  <PageHead title="brand" intro="How to use the logo, colours, type and voice. The files are at the bottom of the page." />

  <section class="block" aria-labelledby="idea">
    <SectionMark index={1} of={10} label="the idea" id="idea" />
    <div class="idea">
      <p class="lead">The dark dots stand for what's already known. The three lit ones are little unknowns, the questions we build products around.</p>
      <p>In the wordmark, <strong class="v">little</strong> sits in the empty space above the "un" of <strong>unknown</strong>, so the small word fits inside the big one.</p>
    </div>
  </section>

  <section class="block" aria-labelledby="logo">
    <SectionMark index={2} of={10} label="logo" id="logo" />
    <div class="grid g2">
      <div class="panel p-white"><Lockup class="s58" /><span class="cap">on light</span></div>
      <div class="panel p-night"><Lockup class="s58" /><span class="cap">on dark</span></div>
    </div>
    <div class="grid g3" style="margin-top:16px">
      <div class="panel p-paper"><Mark size={150} twinkle /><span class="cap">mark</span></div>
      <div class="panel p-white"><Wordmark class="s60" /><span class="cap">wordmark</span></div>
      <div class="panel p-signal"><Lockup class="s38" /><span class="cap">one colour, on vermilion</span></div>
    </div>
  </section>

  <section class="block" aria-labelledby="motion">
    <SectionMark index={3} of={10} label="motion" id="motion" />
    <div class="panel p-night tall"><LogoSting /><span class="cap">sting · for the start or end of a video</span></div>
    <div class="grid g3" style="margin-top:16px">
      <div class="panel p-night"><Mark size={130} twinkle /><span class="cap">loop · avatars and backgrounds</span></div>
      <div class="panel p-night"><DotWave /><span class="cap">transition · between scenes</span></div>
      <div class="panel p-night"><BrandMotion kind="loader" /><span class="cap">loader · while something loads</span></div>
      <div class="panel p-night"><BrandMotion kind="discovery" /><span class="cap">discovery · finding the unknowns</span></div>
      <div class="panel p-night"><BrandMotion kind="ripple" /><span class="cap">ripple · taps and launches</span></div>
      <div class="panel p-night"><BrandMotion kind="connect" /><span class="cap">connect · build to find out</span></div>
      <div class="panel p-night"><BrandMotion kind="ship" /><span class="cap">ship · release announcements</span></div>
      <div class="panel p-night"><BrandMotion kind="tagline" /><span class="cap">tagline · titles and outros</span></div>
      <div class="panel p-night"><BrandMotion kind="shrink" /><span class="cap">small sizes · the mark becomes the favicon</span></div>
    </div>
  </section>

  <section class="block" aria-labelledby="use">
    <SectionMark index={4} of={10} label="using it" id="use" />
    <div class="rules">
      <div><h3>clear space</h3><p>Keep empty space around the logo at least the height of the dot band on every side.</p></div>
      <div><h3>minimum size</h3><p>The full logo: 120px wide on screen, 30mm in print. The mark alone: 24px.</p></div>
      <div><h3>small sizes</h3><p>Below 24px, use the simplified mark of six dots with one lit. It's also the favicon.</p></div>
      <div><h3>motion</h3><p>On screen, the lit dots can pulse gently, one after another. Nothing else in the logo moves.</p></div>
    </div>
  </section>

  <section class="block" aria-labelledby="colour">
    <SectionMark index={5} of={10} label="colour" id="colour" />
    <ul class="swatches">
      {swatches.map(([name, hex, use]) => (
        <li>
          <span class="chip" style={`background:${hex}`}></span>
          <span class="sw-name">{name}</span>
          <code>{hex}</code>
          <span class="comment sw-use">{use}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="type">
    <SectionMark index={6} of={10} label="type" id="type" />
    <div class="type">
      <p class="type-big">JetBrains Mono</p>
      <div class="weights">
        <p><span class="w700">Bold 700</span><span class="comment">the wordmark and headings</span></p>
        <p><span class="w500">Medium 500</span><span class="comment">"little" and emphasis</span></p>
        <p><span class="w400">Regular 400</span><span class="comment">labels, navigation and // comments</span></p>
      </div>
      <p class="type-big sans">IBM Plex Sans</p>
      <div class="weights">
        <p><span class="sans">Regular 400 and Medium 500</span><span class="comment">paragraphs and anything meant to be read at length</span></p>
      </div>
      <p class="small">Labels can be lowercase. Secondary lines start with // in graphite.</p>
    </div>
  </section>

  <section class="block" aria-labelledby="voice">
    <SectionMark index={7} of={10} label="voice" id="voice" />
    <div class="voice">
      <p class="lead">Write the way you'd explain it to a friend.</p>
      <ul class="rows">
        <li><span class="comment">01</span><span>Keep sentences short and say what a thing does.</span></li>
        <li><span class="comment">02</span><span>Write in the present tense, as a studio that has shipped work.</span></li>
        <li><span class="comment">03</span><span>Don't call the products small or side projects. "Little" describes where an idea starts.</span></li>
        <li><span class="comment">04</span><span>Leave out hype words such as revolutionary, seamless and empower.</span></li>
        <li><span class="comment">05</span><span>Say each thing once.</span></li>
      </ul>
    </div>
  </section>

  <section class="block" aria-labelledby="world">
    <SectionMark index={8} of={10} label="in the world" id="world" />

    <div class="grid g3">
      <div class="panel p-white icons">
        <div class="appicon" style="width:120px;height:120px;border-radius:27px"><Mark size={94} /></div>
        <div class="appicon" style="width:64px;height:64px;border-radius:15px"><Mark size={50} /></div>
        <div class="appicon" style="width:40px;height:40px;border-radius:9px"><Mark size={31} /></div>
        <span class="cap">app icon</span>
      </div>
      <div class="panel p-paper icons">
        <Mark size={48} small /><Mark size={32} small /><Mark size={16} small />
        <span class="cap">favicon · 48 / 32 / 16</span>
      </div>
      <div class="panel p-white tabwrap">
        <div class="tab"><Mark size={16} small />little unknown · product studio</div>
        <span class="cap top">browser tab</span>
      </div>
    </div>

    <div class="grid g2" style="margin-top:16px">
      <div class="panel p-stage">
        <div class="phone"><div class="screen">
          {Array.from({ length: 5 }, () => <div class="app"><i></i>App</div>)}
          <div class="app"><i class="lu"><Mark size="78%" /></i>little unknown</div>
          {Array.from({ length: 6 }, () => <div class="app"><i></i>App</div>)}
        </div></div>
        <span class="cap">home screen</span>
      </div>
      <div class="panel p-stage">
        <div class="browser">
          <div class="chrome"><span class="lights"><b></b><b></b><b></b></span><div class="tab"><Mark size={16} small />little unknown</div></div>
          <div class="site">
            <div class="site-nav"><span>// product studio</span><span>work · about · brand</span></div>
            <Lockup class="s38" />
            <div class="site-tag">// everything starts unknown</div>
          </div>
        </div>
        <span class="cap">littleunknown.com</span>
      </div>
    </div>

    <div class="grid g2" style="margin-top:16px">
      <div class="panel p-stage cards">
        <div class="card front"><Mark size={46} /><Wordmark class="s26" /></div>
        <div class="card back"><Wordmark class="s18" /><small>founder<br /><br />littleunknown.com</small></div>
        <span class="cap">business card · front and back</span>
      </div>
      <div class="panel p-stage">
        <div class="social">
          <div class="banner"><Wordmark class="s30" /></div>
          <div class="avatar"><Mark size={56} /></div>
          <div class="who"><b>little unknown</b>@littleunknown · product studio<br />everything starts unknown</div>
        </div>
        <span class="cap">social profile</span>
      </div>
    </div>

    <div class="grid g2" style="margin-top:16px">
      <div class="panel p-stage">
        <img class="og" src="/og.png" width="1200" height="630" alt="The little unknown link preview: the logo on night, with // product studio and // everything starts unknown" loading="lazy" />
        <span class="cap">link preview</span>
      </div>
      <div class="panel p-stage">
        <div class="laptop"><div class="sticker"><Mark size={84} /></div></div>
        <span class="cap">sticker</span>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="dont">
    <SectionMark index={9} of={10} label="please don't" id="dont" />
    <ul class="rows">
      {donts.map((d, i) => <li><span class="comment">{String(i + 1).padStart(2, "0")}</span><span>{d}</span></li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="files">
    <SectionMark index={10} of={10} label="downloads" id="files" />
    <ul class="files">
      {files.map(([name, label]) => (
        <li>
          <span>{label}</span>
          <span class="links"><a href={f(name, "svg")} download>svg</a><a href={f(name, "png")} download>png</a></span>
        </li>
      ))}
      <li><span>App icon, 1024 × 1024</span><span class="links"><a href="/brand/little-unknown-app-icon.png" download>png</a></span></li>
      <li><span>Simplified mark, for small sizes</span><span class="links"><a href="/brand/little-unknown-favicon.svg" download>svg</a></span></li>
    </ul>
    <h3 class="files-head">Social banners</h3>
    <ul class="files">
      {social.map(([name, w, h, label]) => (
        <li>
          <span>{label}, {w} × {h}</span>
          <span class="links">
            <a href={`/brand/social/little-unknown-${name}-light.png`} download>light</a><a href={`/brand/social/little-unknown-${name}-dark.png`} download>dark</a>
          </span>
        </li>
      ))}
    </ul>
    <p class="small" style="margin-top:16px">The text in every file is converted to outlines, so you don't need the fonts installed.</p>
  </section>
</Base>

<style>
  .lead { font-size: clamp(1.15rem, 2.8vw, 1.5rem); font-weight: 500; line-height: 1.4; max-width: 34ch; }
  .idea p + p { margin-top: 14px; max-width: 58ch; }
  strong { font-weight: 500; }
  .v { color: var(--signal); }
  .small { font-size: 15px; }

  .grid { display: grid; gap: 16px; }
  .g2 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); }
  .g3 { grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }

  /* Panels keep fixed brand colours in both themes. */
  .panel {
    position: relative; border-radius: 16px; overflow: hidden;
    min-height: 230px; padding: 44px 28px;
    display: flex; align-items: center; justify-content: center; gap: 22px; flex-wrap: wrap;
    --signal: #ef4b2b;
  }
  .p-white { background: #fff; color: #121512; }
  .p-paper { background: #eef0ec; color: #121512; }
  .p-night { background: #0f120f; color: #e6ebe5; }
  .tall { min-height: 340px; }
  .p-signal { background: #ef4b2b; color: #fff; --signal: #0f120f; }
  .p-stage { background: #d5dbd2; color: #121512; }
  .cap { position: absolute; left: 16px; bottom: 12px; font-size: 11px; color: #5b625b; }
  .cap.top { top: 12px; bottom: auto; }
  .p-night .cap { color: #7d877d; }
  .p-signal .cap { color: #ffe1d8; }
  :global(.s58) { font-size: clamp(30px, 5vw, 58px); }
  :global(.s60) { font-size: clamp(36px, 5vw, 60px); }
  :global(.s38) { font-size: 38px; }
  :global(.s30) { font-size: 30px; }
  :global(.s26) { font-size: 26px; }
  :global(.s18) { font-size: 18px; }

  .rules { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 24px; }
  .rules h3 { font-size: inherit; font-weight: 500; }
  .rules p { margin-top: 6px; color: var(--graphite); }

  .swatches { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 16px; }
  .swatches li { display: grid; grid-template-columns: 56px minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 14px; align-items: center; }
  .chip { grid-row: 1 / 4; width: 56px; height: 56px; border-radius: 12px; border: 1px solid var(--rule); }
  .sw-name { font-weight: 500; }
  code { font-size: 14px; }
  .sw-use { font-size: 14px; line-height: 1.4; }

  .type-big { font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; }
  .weights { margin: 20px 0 16px; }
  .weights p { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--rule); flex-wrap: wrap; }
  .weights p:last-child { border-bottom: 1px solid var(--rule); }
  .w700 { font-weight: 700; } .w500 { font-weight: 500; } .w400 { font-weight: 400; }
  .type-big.sans, .sans { font-family: var(--sans); }
  .type-big.sans { margin-top: 36px; font-weight: 500; letter-spacing: -0.02em; }

  .rows { list-style: none; margin-top: 18px; }
  .rows li { padding: 10px 0; border-top: 1px solid var(--rule); display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); }
  .rows li:last-child { border-bottom: 1px solid var(--rule); }
  

  .files { list-style: none; }
  .files-head { margin: 40px 0 12px; font-size: 1rem; font-weight: 700; }
  .files li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid var(--rule); flex-wrap: wrap; }
  .files li:last-child { border-bottom: 1px solid var(--rule); }
  .links a + a { margin-left: 18px; }

  /* mockups */
  .appicon { background: #0f120f; color: #e6ebe5; display: flex; align-items: center; justify-content: center; }
  .icons { align-items: center; }
  .tabwrap { align-items: flex-end; justify-content: flex-start; padding-bottom: 0; }
  .tab { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: #eef0ec; color: #121512; border-radius: 9px 9px 0 0; font: 12px -apple-system, system-ui, sans-serif; white-space: nowrap; }

  .phone { width: 250px; height: 500px; border-radius: 40px; background: linear-gradient(160deg, #2b322b, #151915); padding: 13px; box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .35); }
  .screen { height: 100%; border-radius: 28px; background: linear-gradient(180deg, #c9d2c6, #9fac9b); padding: 50px 14px 16px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: min-content; gap: 16px 10px; font-family: -apple-system, system-ui, sans-serif; }
  .app { display: flex; flex-direction: column; align-items: center; gap: 5px; font-size: 9px; color: #fff; text-align: center; line-height: 1.2; text-shadow: 0 1px 2px rgba(0, 0, 0, .25); }
  .app i { width: 100%; aspect-ratio: 1; border-radius: 24%; background: rgba(255, 255, 255, .45); display: flex; align-items: center; justify-content: center; }
  .app i.lu { background: #0f120f; color: #e6ebe5; }

  .browser { width: 100%; max-width: 540px; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 20px 50px -24px rgba(0, 0, 0, .3); }
  .chrome { background: #dfe3dd; padding: 10px 12px 0; display: flex; align-items: flex-end; }
  .lights { display: flex; gap: 6px; margin: 0 14px 10px 2px; }
  .lights b { width: 10px; height: 10px; border-radius: 50%; background: #c4c9c2; }
  .site { background: #eef0ec; padding: 20px 24px 36px; }
  .site-nav { display: flex; justify-content: space-between; font-size: 11px; color: #5b625b; margin-bottom: 40px; }
  .site-tag { color: #5b625b; font-size: 12px; margin-top: 14px; }

  .cards { gap: 18px; }
  .card { width: 290px; height: 166px; border-radius: 10px; padding: 20px 22px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; box-shadow: 0 18px 40px -20px rgba(0, 0, 0, .35); }
  .card.front { background: #0f120f; color: #e6ebe5; }
  .card.back { background: #fff; color: #121512; }
  .card small { font-size: 10px; color: #5b625b; line-height: 1.6; }

  .social { width: 100%; max-width: 430px; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 18px 40px -24px rgba(0, 0, 0, .3); font-family: -apple-system, system-ui, sans-serif; }
  .banner { height: 116px; background: #0f120f; color: #e6ebe5; display: flex; align-items: center; justify-content: flex-end; padding-right: 26px; }
  .avatar { width: 84px; height: 84px; border-radius: 50%; background: #0f120f; color: #e6ebe5; border: 4px solid #fff; margin: -42px 0 0 18px; display: flex; align-items: center; justify-content: center; }
  .who { padding: 8px 18px 18px; font-size: 13px; color: #555; }
  .who b { display: block; font-size: 16px; color: #111; }

  .og { width: 100%; max-width: 560px; height: auto; border-radius: 12px; box-shadow: 0 20px 50px -24px rgba(0, 0, 0, .35); }
  .laptop { width: 100%; max-width: 400px; aspect-ratio: 16 / 10; border-radius: 16px; background: linear-gradient(150deg, #b9bfba, #8d948e); display: flex; align-items: center; justify-content: center; }
  .sticker { width: 120px; height: 120px; border-radius: 50%; background: #0f120f; color: #e6ebe5; border: 5px solid #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 14px -6px rgba(0, 0, 0, .4); }

  @media (max-width: 480px) {
    .panel { padding: 40px 16px; }
    .card { width: 100%; max-width: 290px; }
  }
</style>
