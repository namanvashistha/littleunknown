---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DotField from "../components/DotField.astro";
import SectionMark from "../components/SectionMark.astro";
import { site, products, productGraph } from "../site.js";
import icon from "../assets/calm-chess/icon.png";
import shotCoach from "../assets/calm-chess/2-coach.png";
import shotPress from "../assets/calm-chess/3-long-press.png";
import shotDark from "../assets/calm-chess/5-dark.png";

const chess = products[0];
const shots = [
  { src: shotPress, alt: "Calm Chess: holding a piece shows what guards it and what attacks it" },
  { src: shotCoach, alt: "Calm Chess: the coach says “Great move, claims the centre” after 1. e4" },
  { src: shotDark, alt: "Calm Chess in dark mode, showing a knight's moves as lines of light" },
];

// Small dot diagrams for the three principles: o known, a lit, . empty.
const principles = [
  {
    title: "question everything",
    text: "We start from what people actually need, not from what's expected. Most of what's known is noise; the lit dot is the question worth answering.",
    dots: ["ooooo", "oooao", "ooooo"],
  },
  {
    title: "build to find out",
    text: "We answer questions by making things, not by waiting for certainty. Each build connects one unknown to the next.",
    dots: ["aoooo", "oaooo", "ooaoo"],
    path: true,
  },
  {
    title: "ship what matters",
    text: "We put the work in people's hands and keep improving it. Shipping is how a little unknown leaves the grid.",
    dots: ["oooo.", "oooo.", "ooooo"],
    escape: true,
  },
];

function diagram({ dots, path, escape }: { dots: string[]; path?: boolean; escape?: boolean }) {
  const step = 20;
  let out = "";
  const lit: [number, number][] = [];
  dots.forEach((row, y) => [...row].forEach((ch, x) => {
    if (ch === ".") return;
    const cx = x * step + 10, cy = y * step + 10;
    if (ch === "a") lit.push([cx, cy]);
    out += `<circle cx="${cx}" cy="${cy}" r="5" class="${ch === "a" ? "lit" : ""}"/>`;
  }));
  if (path && lit.length > 1) out = `<path d="M${lit.map((p) => p.join(" ")).join(" L")}" class="link"/>` + out;
  if (escape) out += `<circle cx="${4 * step + 16}" cy="4" r="5" class="lit"/>`;
  return out;
}
---
<Base
  title={`${site.name} · product studio`}
  description={`${site.manifesto} ${site.name} designs, builds and ships apps and software products, including ${chess.name}.`}
  graph={productGraph}
  wide
>
  <section class="hero" aria-labelledby="hero-title">
    <DotField />
    <div class="hero-copy">
      <h1 id="hero-title">{site.manifesto}</h1>
      <div class="hero-side">
        <p class="comment">// {site.tagline}</p>
        <p>little unknown is a product studio. We design, build and ship apps for iPhone, Android and the web.</p>
        <a class="now" href="#work"><span class="comment">&gt; now</span> {chess.name.toLowerCase()} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section id="work" class="block" aria-labelledby="work-title">
    <SectionMark index={1} of={3} label="work" id="work-title" />

    <article class="product" aria-labelledby="calm-chess">
      <div class="product-copy">
        <div class="product-title">
          <Image src={icon} alt="" width={76} height={76} class="product-icon" />
          <div>
            <h3 id="calm-chess">{chess.name}</h3>
            <p class="comment">// {chess.subtitle.toLowerCase()}</p>
          </div>
        </div>
        <p class="product-lead">{chess.summary}</p>
        <p class="product-body">{chess.description}</p>
        <ol class="rows">
          {chess.features.map(([title, text], i) => (
            <li>
              <span class="comment">{String(i + 1).padStart(2, "0")}</span>
              <span><strong>{title}.</strong> <span class="soft">{text}.</span></span>
            </li>
          ))}
        </ol>
        <div class="product-foot">
          <span class="comment">// {chess.platforms.join(" · ").toLowerCase()} · {chess.status}</span>
          <a href={chess.url}>more about {chess.name.toLowerCase()} →</a>
        </div>
      </div>

      <div class="product-shots">
        {shots.map(({ src, alt }, i) => (
          <Image src={src} alt={alt} widths={[280, 420, 560]} sizes="(max-width: 900px) 30vw, 230px" class={`shot shot-${i}`} />
        ))}
      </div>
    </article>
  </section>

  <section class="block" aria-labelledby="how-title">
    <SectionMark index={2} of={3} label="how we work" id="how-title" />
    <ol class="principles">
      {principles.map((p, i) => (
        <li>
          <svg class="diagram" viewBox="0 0 110 60" aria-hidden="true" set:html={diagram(p)} />
          <h3><span class="comment">{String(i + 1).padStart(2, "0")}</span> {p.title}.</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="block" aria-labelledby="studio-title">
    <SectionMark index={3} of={3} label="the studio" id="studio-title" />
    <div class="studio">
      <p class="studio-lead">Every product we make began as an open question: something people needed that nobody had answered well.</p>
      <div class="studio-side">
        <p>little unknown is run by <a href={site.founder.url} rel="author">{site.founder.name}</a>, who designs, builds and ships each product end to end: research, design, engineering and launch, in one place.</p>
        <p><a href="/about/">about the studio →</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* hero */
  .hero { padding-top: 8px; }
  .hero-copy {
    margin-top: clamp(40px, 7vw, 72px);
    display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 40px 64px; align-items: end;
  }
  h1 {
    font-size: clamp(2.1rem, 5.6vw, 4.6rem);
    font-weight: 700; letter-spacing: -0.045em; line-height: 1.02;
    text-wrap: balance;
  }
  .hero-side { display: flex; flex-direction: column; gap: 14px; font-size: 15px; max-width: 34ch; }
  .now {
    align-self: flex-start; margin-top: 8px;
    display: inline-flex; gap: 10px; padding: 9px 16px;
    border: 1px solid var(--rule); border-radius: 999px; color: var(--ink); font-size: 14px;
  }
  .now:hover { text-decoration: none; border-color: var(--graphite); }

  .block { margin-top: clamp(112px, 16vw, 176px); scroll-margin-top: 24px; }
  .block > :global(.section-mark) { padding-bottom: 16px; border-bottom: 1px solid var(--ink); }

  /* work */
  .product {
    margin-top: 48px;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center;
  }
  .product-title { display: flex; align-items: center; gap: 18px; }
  :global(.product-icon) { width: 76px; height: 76px; border-radius: 18px; border: 1px solid var(--rule); }
  h3 { font-weight: 700; letter-spacing: -0.035em; }
  .product-title h3 { font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1; }
  .product-lead { margin-top: 30px; font-size: clamp(1.15rem, 2.4vw, 1.45rem); font-weight: 500; line-height: 1.4; max-width: 30ch; }
  .product-body { margin-top: 14px; max-width: 56ch; }
  .rows { margin-top: 28px; }
  strong { font-weight: 500; }
  .soft { color: var(--graphite); }
  .product-foot { margin-top: 24px; display: flex; justify-content: space-between; gap: 10px 24px; flex-wrap: wrap; font-size: 14px; }

  .product-shots { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 18px); align-items: center; }
  :global(.shot) { width: 100%; height: auto; border-radius: clamp(14px, 2vw, 24px); border: 1px solid var(--rule); background: var(--rule); box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .45); }
  :global(.shot-1) { transform: translateY(-28px); }

  /* how we work */
  .principles { list-style: none; margin-top: 48px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  .diagram { width: 132px; height: auto; overflow: visible; }
  .diagram :global(circle) { fill: var(--ink); }
  .diagram :global(circle.lit) { fill: var(--signal); }
  .diagram :global(.link) { fill: none; stroke: var(--signal); stroke-width: 2; }
  .principles h3 { margin-top: 26px; font-size: clamp(1.2rem, 2.2vw, 1.45rem); font-weight: 700; line-height: 1.2; }
  .principles h3 .comment { font-weight: 400; font-size: .7em; margin-right: 6px; letter-spacing: 0; }
  .principles p { margin-top: 10px; color: var(--graphite); max-width: 38ch; }

  /* studio */
  .studio { margin-top: 48px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 40px 64px; align-items: start; }
  .studio-lead { font-size: clamp(1.4rem, 3.4vw, 2.4rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1.15; text-wrap: balance; }
  .studio-side p + p { margin-top: 16px; }

  @media (max-width: 900px) {
    .hero-copy, .product, .studio { grid-template-columns: minmax(0, 1fr); }
    .principles { grid-template-columns: minmax(0, 1fr); gap: 44px; }
    .product-shots { max-width: 560px; }
  }
  @media (max-width: 480px) {
    :global(.shot-1) { transform: translateY(-14px); }
  }
</style>
