---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DotField from "../components/DotField.astro";
import SectionMark from "../components/SectionMark.astro";
import { site, products, productGraph } from "../site.js";
import chessIcon from "../assets/calm-chess/icon.png";
import chessCoach from "../assets/calm-chess/2-coach.png";
import chessPress from "../assets/calm-chess/3-long-press.png";
import chessDark from "../assets/calm-chess/5-dark.png";
import testIcon from "../assets/einbuergerungstest/icon.png";
import testHome from "../assets/einbuergerungstest/1-home.png";
import testQuestion from "../assets/einbuergerungstest/2-question.png";
import testMocks from "../assets/einbuergerungstest/3-mock-tests.png";
import pandaIcon from "../assets/lazy-gym-buddy/icon.png";
import pandaSofa from "../assets/lazy-gym-buddy/1-sofa.png";
import pandaWorkout from "../assets/lazy-gym-buddy/2-working-out.png";
import pandaDone from "../assets/lazy-gym-buddy/3-we-did-it.png";

// Icon and three screenshots per product, keyed by slug in site.js.
const media = {
  "calm-chess": {
    icon: chessIcon,
    shots: [
      { src: chessPress, alt: "Calm Chess: holding a piece shows what guards it and what attacks it" },
      { src: chessCoach, alt: "Calm Chess: the coach says “Great move, claims the centre” after 1. e4" },
      { src: chessDark, alt: "Calm Chess in dark mode, showing a knight's moves as lines of light" },
    ],
  },
  einbuergerungstest: {
    icon: testIcon,
    shots: [
      { src: testHome, alt: "Einbürgerungstest: an estimated score of 18 of 33 today, and progress across all 310 questions" },
      { src: testQuestion, alt: "Einbürgerungstest: a question in German with the English translation under it and the right answer marked" },
      { src: testMocks, alt: "Einbürgerungstest: mock test history with the best score, the average and a chart against the pass mark" },
    ],
  },
  "lazy-gym-buddy": {
    icon: pandaIcon,
    shots: [
      { src: pandaSofa, alt: "Lazy Gym Buddy: Bao on the sofa says “i'll work out... if you do”" },
      { src: pandaWorkout, alt: "Lazy Gym Buddy: Bao working out beside a timer, saying “glad you came. i wouldn't have.”" },
      { src: pandaDone, alt: "Lazy Gym Buddy: Bao cheering “we did it!” over the minutes, steps and days this week" },
    ],
  },
};
const shortNames = products.map((p) => p.shortName ?? p.name);
const names = `${shortNames.slice(0, -1).join(", ")} and ${shortNames.at(-1)}`;

// Small dot diagrams for the three principles: o known, a lit, . empty.
const principles = [
  {
    title: "question everything",
    dots: ["ooooo", "oooao", "ooooo"],
  },
  {
    title: "build to find out",
    dots: ["aoooo", "oaooo", "ooaoo"],
    path: true,
  },
  {
    title: "ship what matters",
    dots: ["oooo.", "oooo.", "ooooo"],
    escape: true,
  },
];

function diagram({ dots, path, escape }: { dots: string[]; path?: boolean; escape?: boolean }) {
  const step = 20;
  let out = "";
  const lit: [number, number][] = [];
  dots.forEach((row, y) => [...row].forEach((ch, x) => {
    if (ch === ".") return;
    const cx = x * step + 10, cy = y * step + 10;
    if (ch === "a") lit.push([cx, cy]);
    out += `<circle cx="${cx}" cy="${cy}" r="5" class="${ch === "a" ? "lit" : ""}"/>`;
  }));
  if (path && lit.length > 1) out = `<path d="M${lit.map((p) => p.join(" ")).join(" L")}" class="link"/>` + out;
  if (escape) out += `<circle cx="${4 * step + 16}" cy="4" r="5" class="lit"/>`;
  return out;
}
---
<Base
  title={`${site.name} · product studio`}
  description={`${site.name} is a product studio that makes apps for iPhone, Android and the web. Its work includes ${names}.`}
  graph={productGraph}
>
  <section class="hero" aria-labelledby="hero-title">
    <DotField />
    <div class="hero-copy">
      <h1 id="hero-title">{site.manifesto}</h1>
      <p class="hero-side">We make apps for iPhone, Android and the web.</p>
    </div>
  </section>

  <section id="work" class="block" aria-labelledby="work-title">
    <SectionMark index={1} of={2} label="work" id="work-title" />

    {products.map((p) => (
      <article class="product" aria-labelledby={p.slug}>
        <div class="product-copy">
          <div class="product-title">
            <Image src={media[p.slug].icon} alt="" width={76} height={76} class="product-icon" />
            <h3 id={p.slug} lang={p.nameLang}>{p.shortName ?? p.name}</h3>
          </div>
          <p class="product-lead">{p.summary}</p>
          <p class="product-foot"><span class="comment">{p.status}</span> <a href={p.url}>more →</a></p>
        </div>

        <div class="product-shots">
          {media[p.slug].shots.map(({ src, alt }, i) => (
            <Image src={src} alt={alt} widths={[280, 420, 560]} sizes="(max-width: 900px) 30vw, 230px" class={`shot shot-${i}`} />
          ))}
        </div>
      </article>
    ))}
  </section>

  <section class="block" aria-labelledby="how-title">
    <SectionMark index={2} of={2} label="how we work" id="how-title" />
    <ol class="principles">
      {principles.map((p) => (
        <li>
          <svg class="diagram" viewBox="0 0 110 60" aria-hidden="true" set:html={diagram(p)} />
          <h3>{p.title}</h3>
        </li>
      ))}
    </ol>
  </section>

</Base>

<style>
  /* hero */
  .hero { padding-top: 8px; }
  .hero-copy {
    margin-top: clamp(40px, 7vw, 72px);
    display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 40px 64px; align-items: end;
  }
  h1 {
    font-size: clamp(2.1rem, 5.6vw, 4.6rem);
    font-weight: 700; letter-spacing: -0.045em; line-height: 1.02;
    text-wrap: balance;
  }
  .hero-side { max-width: 26ch; color: var(--graphite); }

  /* work */
  .product + .product { margin-top: clamp(72px, 10vw, 120px); }
  .product {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center;
  }
  .product-title { display: flex; align-items: center; gap: 18px; }
  :global(.product-icon) { width: 76px; height: 76px; border-radius: 18px; border: 1px solid var(--rule); }
  h3 { font-weight: 700; letter-spacing: -0.035em; }
  .product-title h3 { font-size: clamp(2rem, 4.4vw, 3rem); line-height: 1; min-width: 0; hyphens: auto; overflow-wrap: break-word; }
  .product-lead { margin-top: 28px; font-size: clamp(1.15rem, 2.4vw, 1.45rem); font-weight: 500; line-height: 1.4; max-width: 30ch; }
  .product-foot { margin-top: 20px; font-size: 15px; }
  .product-foot a { margin-left: 12px; }

  .product-shots { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 18px); align-items: center; }
  :global(.shot) { width: 100%; height: auto; border-radius: clamp(14px, 2vw, 24px); border: 1px solid var(--rule); background: var(--rule); box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .45); }

  /* how we work */
  .principles { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; }
  .diagram { width: 132px; height: auto; overflow: visible; }
  .diagram :global(circle) { fill: var(--ink); fill-opacity: .2; }
  .diagram :global(circle.lit) { fill: var(--signal); fill-opacity: 1; }
  .diagram :global(.link) { fill: none; stroke: var(--signal); stroke-width: 2; }
  .principles h3 { margin-top: 26px; font-size: clamp(1.2rem, 2.2vw, 1.45rem); font-weight: 700; line-height: 1.2; }

  @media (max-width: 900px) {
    .hero-copy, .product { grid-template-columns: minmax(0, 1fr); }
    .principles { grid-template-columns: minmax(0, 1fr); gap: 44px; }
    .product-shots { max-width: 560px; }
  }
</style>
