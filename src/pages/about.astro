---
import Base from "../layouts/Base.astro";
import SectionMark from "../components/SectionMark.astro";
import PageHead from "../components/PageHead.astro";
import { site, products } from "../site.js";

const names = products.map((p) => p.shortName ?? p.name);
const list = `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;

// Each section answers one question, once. The same answers feed the FAQ
// structured data, so search and AI answer engines quote what the page says.
const answers = [
  {
    id: "what",
    label: "what it is",
    q: "What is little unknown?",
    a: `${site.name} is a product studio that makes apps for iPhone, Android and the web. It takes each product from the first idea to its release in the app stores.`,
  },
  {
    id: "name",
    label: "the name",
    q: "What does the name little unknown mean?",
    a: "Most products start as a small question that nobody has answered well yet. We call those little unknowns, and finding them is where our work begins.",
  },
  {
    id: "who",
    label: "who runs it",
    q: "Who runs little unknown?",
    a: "The studio is run by its founder, a software engineer, who takes each product from the first idea to the app stores.",
  },
  {
    id: "made",
    label: "what we've made",
    q: "What has little unknown made?",
    a: "Calm Chess, a chess app for iPhone and Android with a coach that explains every move. Einbürgerungstest: Leben in DE, which prepares people for the German citizenship test in German and their own language. And Lazy Gym Buddy, a panda who loves working out but won't go alone. All three are coming to the App Store.",
    link: ["/#work", "see the work"],
  },
];

const faqGraph = [
  {
    "@type": "FAQPage",
    "@id": `${site.url}/about/#faq`,
    mainEntity: answers.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<Base
  title={`about · ${site.name}`}
  description={`What ${site.name} is, what the name means, who runs it and what it has made.`}
  pageType="AboutPage"
  graph={faqGraph}
>
  <PageHead title="about" intro={`The studio behind ${list}.`} />

  {answers.map(({ id, label, a, link }, i) => (
    <section class="block" aria-labelledby={id}>
      <SectionMark index={i + 1} of={answers.length + 1} label={label} id={id} />
      <div class="measure answer">
        <p>{a}</p>
        {link && <p><a href={link[0]}>{link[1]} →</a></p>}
      </div>
    </section>
  ))}

  <section class="block" aria-labelledby="facts">
    <SectionMark index={answers.length + 1} of={answers.length + 1} label="facts" id="facts" />
    <dl class="facts">
      <dt class="comment">name</dt><dd>{site.name}</dd>
      <dt class="comment">type</dt><dd>product studio</dd>
      <dt class="comment">platforms</dt><dd>iPhone, Android and the web</dd>
      <dt class="comment">products</dt><dd>{list}</dd>
      <dt class="comment">tagline</dt><dd>{site.tagline}</dd>
      <dt class="comment">website</dt><dd>littleunknown.com</dd>
    </dl>
  </section>
</Base>

<style>
  /* About is a short page: its answers sit closer together than home's sections. */
  .block { margin-top: clamp(64px, 8vw, 96px); }
  .answer { font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.55; }
  .facts { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 8px 16px; max-width: 60ch; }
</style>
