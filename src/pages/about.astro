---
import Base from "../layouts/Base.astro";
import SectionMark from "../components/SectionMark.astro";
import { site, products } from "../site.js";

const chess = products[0];

// Each section answers one question, once. The same answers feed the FAQ
// structured data, so search and AI answer engines quote what the page says.
const answers = [
  {
    id: "what",
    label: "what it is",
    q: "What is little unknown?",
    a: `${site.name} is a product studio that makes apps for iPhone, Android and the web. It takes each product from the first idea to its release in the app stores.`,
  },
  {
    id: "name",
    label: "the name",
    q: "What does the name little unknown mean?",
    a: "Most products start as a small question that nobody has answered well yet. We call those little unknowns, and finding them is where our work begins.",
  },
  {
    id: "who",
    label: "who runs it",
    q: "Who runs little unknown?",
    a: `${site.founder.name}, a software engineer, founded the studio and runs it.`,
    link: [site.founder.url, "namanvashistha.com"],
  },
  {
    id: "made",
    label: "what we've made",
    q: "What has little unknown made?",
    a: `${chess.name}, a chess app for iPhone and Android with a coach that explains every move. It's coming to the App Store and Google Play.`,
    link: ["/#work", `see ${chess.name}`],
  },
];

const faqGraph = [
  {
    "@type": "FAQPage",
    "@id": `${site.url}/about/#faq`,
    mainEntity: answers.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<Base
  title={`about · ${site.name}`}
  description={`What ${site.name} is, what the name means, who runs it and what it has made.`}
  pageType="AboutPage"
  graph={faqGraph}
>
  <h1>about</h1>
  <p class="intro">The studio behind {chess.name}.</p>

  {answers.map(({ id, label, a, link }, i) => (
    <section class="section" aria-labelledby={id}>
      <SectionMark index={i + 1} of={answers.length + 1} label={label} id={id} />
      <div>
        <p>{a}</p>
        {link && <p class="more"><a href={link[0]}>{link[1]} →</a></p>}
      </div>
    </section>
  ))}

  <section class="section" aria-labelledby="facts">
    <SectionMark index={answers.length + 1} of={answers.length + 1} label="facts" id="facts" />
    <dl class="facts">
      <dt class="comment">name</dt><dd>{site.name}</dd>
      <dt class="comment">type</dt><dd>product studio</dd>
      <dt class="comment">founder</dt><dd>{site.founder.name}</dd>
      <dt class="comment">platforms</dt><dd>iPhone, Android and the web</dd>
      <dt class="comment">products</dt><dd>{chess.name}</dd>
      <dt class="comment">tagline</dt><dd>{site.tagline}</dd>
      <dt class="comment">website</dt><dd>littleunknown.com</dd>
    </dl>
  </section>
</Base>

<style>
  h1 {
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .intro {
    margin: 20px 0 72px;
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    line-height: 1.5;
  }
  .section p { max-width: 54ch; }
  .more { margin-top: 12px; }
  .facts { display: grid; grid-template-columns: 7rem minmax(0, 1fr); gap: 8px 16px; }
</style>
