---
// An email sign-up for one app's waitlist. Posts straight to Supabase (insert-only key);
// a repeat sign-up counts as already on the list. Without a key it opens an email instead.
import { waitlist } from "../site.js";

interface Props {
  app: string;      // the slug, as allowed by the waitlist table
  name: string;     // used in the field's label
  source?: string;  // where the sign-up came from, e.g. "links"
}
const { app, name, source = "site" } = Astro.props;
const id = `wl-${app}`;
---
<form class="waitlist" data-app={app} data-source={source} data-url={waitlist.url} data-key={waitlist.key} novalidate>
  <label class="sr-only" for={id}>Email for {name}</label>
  <div class="row">
    <input id={id} name="email" type="email" inputmode="email" autocomplete="email" placeholder="Your email" required maxlength="254" />
    <button type="submit">Notify me</button>
  </div>
  <p class="status" aria-live="polite"></p>
</form>

<script>
  const FALLBACK = "hello@mail.littleunknown.com";

  for (const form of document.querySelectorAll<HTMLFormElement>("form.waitlist")) {
    const input = form.querySelector("input")!;
    const button = form.querySelector("button")!;
    const status = form.querySelector(".status")!;
    const { app, source, url, key } = form.dataset;
    const say = (text: string, ok = true) => { status.textContent = text; status.classList.toggle("bad", !ok); };

    input.addEventListener("input", () => say(""));
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = input.value.trim().toLowerCase();
      if (!email || !input.checkValidity()) return say("That email doesn't look right.", false);
      if (!key) {
        location.href = `mailto:${FALLBACK}?subject=${encodeURIComponent(`${app} waitlist`)}&body=${encodeURIComponent(email)}`;
        return;
      }
      button.disabled = true;
      button.textContent = "Adding…";
      try {
        const res = await fetch(url!, {
          method: "POST",
          headers: { apikey: key, Authorization: `Bearer ${key}`, "Content-Type": "application/json", Prefer: "return=minimal" },
          body: JSON.stringify({ app, email, source }),
        });
        if (!res.ok && res.status !== 409) throw new Error(String(res.status));
        form.classList.add("done");
        say(res.ok ? "You're on the list. We'll email you once, when it's out." : "You're already on the list.");
        (window as any).umami?.track("waitlist", { app, source });
      } catch {
        button.disabled = false;
        button.textContent = "Notify me";
        say("That didn't go through. Try again in a moment.", false);
      }
    });
  }
</script>

<style>
  .row { display: flex; gap: 8px; }
  input {
    flex: 1; min-width: 0; height: 46px; padding: 0 16px;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--paper);
    color: var(--ink); font: 16px var(--sans);
    transition: border-color .15s;
  }
  input::placeholder { color: var(--graphite); }
  input:focus { outline: none; border-color: var(--ink); }
  button {
    flex: none; height: 46px; padding: 0 18px; border: 0; border-radius: 12px; cursor: pointer;
    background: var(--ink); color: var(--paper); font: 500 15px var(--sans);
    transition: transform .1s, opacity .15s;
  }
  button:active { transform: scale(.97); }
  button:disabled { opacity: .55; cursor: default; }
  button:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
  .status { font-size: 14px; color: var(--graphite); }
  .status:not(:empty) { margin-top: 10px; }
  .status.bad { color: var(--link); }
  .done .row { display: none; }
  .done .status { margin-top: 0; color: var(--ink); font-weight: 500; }
  .done .status::before { content: "✓  "; color: var(--signal); }
</style>
